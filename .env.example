# Copy to .env.local and fill in. Never commit real values.

# Postgres. Production: use SSL, e.g. ...?sslmode=require
DATABASE_URL=postgres://petal@localhost:54329/petal
DATABASE_POOL_MAX=10

# Public origin of the site, no trailing slash. Must be https in production.
APP_URL=http://localhost:3000

# Stripe (Dashboard -> Developers -> API keys). Prefer a restricted key (rk_...) with
# write access to Checkout Sessions and Refunds only.
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the endpoint's signing secret in the Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Image uploads: "local" (.data/uploads, single server only) or "vercel-blob".
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/maintenance. Generate with: openssl rand -base64 48
CRON_SECRET=

# "1" when behind Vercel / a proxy that sets X-Forwarded-For; "0" when exposed directly.
TRUST_PROXY=1

# "1" shows a "Demo store: use test card 4242..." note at checkout. Remove when taking real payments.
NEXT_PUBLIC_DEMO_MODE=
